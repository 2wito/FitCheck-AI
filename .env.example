# --- Database (Supabase: Connect button > ORMs > Prisma) ---
# Pooled connection via Supavisor transaction mode (port 6543). Used by the app at runtime.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
# Session-mode connection (port 5432). Used by the Prisma CLI for migrations.
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Supabase API (Project Settings > API Keys) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# Legacy "anon" key, or the newer "sb_publishable_..." key; both work here.
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"
# Server-only secret (Project Settings > API Keys > service_role / secret key). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# --- AI ---
# Gemini API key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY="YOUR-GEMINI-API-KEY"
# Optional: pin a specific model (defaults to gemini-flash-latest)
# GEMINI_MODEL="gemini-flash-latest"

# --- Online image search (Search online tab) ---
# Free key (2,500 searches) from https://serper.dev
SERPER_API_KEY="YOUR-SERPER-API-KEY"

# --- Auth ---
# Leave unset/"false" for open demo mode (no login, everyone shares one "Dev User" closet).
# Set to "true" to require Supabase sign-in. Changing it requires a redeploy.
AUTH_ENABLED="false"
# Set to "true" after enabling the Google provider in Supabase (Authentication > Providers).
GOOGLE_AUTH_ENABLED="false"
